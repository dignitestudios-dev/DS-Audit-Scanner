# Google PageSpeed Insights API key (free). Without it the scanner still runs, using the
# built-in speed checks only (response time, compression, caching).
PSI_API_KEY=

# Access codes that unlock the full report and PDF for free. Comma separated, case-insensitive.
# Leave empty to disable the "Have an access code?" box. Example: ACCESS_CODES=DS-PILOT-01,FRIEND-2026
ACCESS_CODES=
