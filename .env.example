# Optional. Google PageSpeed Insights API key (free). Without it the scanner
# still runs, using the built-in speed checks only (response time, compression, caching).
PSI_API_KEY=

# Where the "get the full audit" button points.
NEXT_PUBLIC_AUDIT_URL=https://dignitestudios.net

# Optional. Cloudflare Turnstile keys (free) to block bots. Not wired yet.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Access codes that unlock the full report for free. Comma separated, case-insensitive.
# Leave empty to disable the "Have an access code?" box. Example: ACCESS_CODES=DS-PILOT-01,FRIEND-2026
ACCESS_CODES=

# Contact details used by the "Talk to us" button.
NEXT_PUBLIC_CONTACT_EMAIL=info@dignitestudios.com
NEXT_PUBLIC_CONTACT_PHONE=+18777141770
